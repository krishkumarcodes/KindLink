{
  "name": "@krishkumarcodes/kindlink",
  "version": "3.4.0",
  "description": "Hyper-local community mutual aid and emergency response platform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishkumarcodes/KindLink.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "type-check": "node ./node_modules/typescript/bin/tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "seed:demo": "node scripts/seed.mjs",
    "seed:demo:remove": "node scripts/seed.mjs --clean",
    "indexnow": "node scripts/indexnow.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:clean": "node scripts/check-clean.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "check:maps": "node scripts/check-maps.mjs",
    "maps:check": "node scripts/maps-check.mjs",
    "check:profile": "node scripts/check-profile.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@next/swc-wasm-nodejs": "^14.2.15",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-leaflet": "^4.2.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "vaul": "^1.1.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
