# ==============================================================================
# KindLink Environment Configuration (.env.example)
# Community Mutual Aid Platform - KindLink Community Initiative
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Render cloud deployment, see .env.render or render.yaml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Port the Node.js server listens on (default: 3000)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATA SOURCE CONFIGURATION
# ------------------------------------------------------------------------------
# DATA_SOURCE determines whether KindLink communicates with the live Supabase
# PostgreSQL backend or operates entirely in offline mock simulation mode.
#
# Options:
#   - 'supabase' (Default): Connects to live Supabase backend (PostgreSQL, Auth,
#                           Realtime channels, RLS policies, and RPCs).
#   - 'mock'              : Fully self-contained offline demonstration mode. Uses
#                           pre-seeded in-memory mock datasets (helpful for offline
#                           presentations, unit tests, and air-gapped demos).
DATA_SOURCE=supabase
NEXT_PUBLIC_DATA_SOURCE=supabase

# ------------------------------------------------------------------------------
# 3. BASE CANONICAL URL
# ------------------------------------------------------------------------------
# Used for canonical SEO links, metadata, Open Graph cards, sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. SUPABASE PUBLIC CREDENTIALS (Client & Server)
# ------------------------------------------------------------------------------
# Supabase Project: KindLink (pwfvaajngfmnmsfmqgyx)
# Region: ap-northeast-1 (Tokyo)
#
# KEY FORMAT NOTES:
# 1. Legacy JWT Format (Default & standard for @supabase/supabase-js v2 & Next.js):
#    eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB3ZnZhYWpuZ2Ztbm1zZm1xZ3l4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE4ODc3ODUsImV4cCI6MjEwNzQ2Mzc4NX0.LSbxXDJJe0PfZsf_JUPD88f5W9KAJVfyKMHIyTLDnWg
#
# 2. New Supabase 2024+ Format:
#    sb_publishable_JeO_LxYPZFhNoIl5a7tkZw_cogjbwdY
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL:
# The REST & WebSocket endpoint URL of your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://pwfvaajngfmnmsfmqgyx.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY:
# The public/anon JWT API key for your Supabase project. Safe for browser bundles.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB3ZnZhYWpuZ2Ztbm1zZm1xZ3l4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE4ODc3ODUsImV4cCI6MjEwNzQ2Mzc4NX0.LSbxXDJJe0PfZsf_JUPD88f5W9KAJVfyKMHIyTLDnWg

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
# Alias supporting either legacy JWT format or modern 2024+ format (sb_publishable_JeO_LxYPZFhNoIl5a7tkZw_cogjbwdY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_JeO_LxYPZFhNoIl5a7tkZw_cogjbwdY

# ------------------------------------------------------------------------------
# 5. SUPABASE SERVER SECRETS (Server-Only, Private)
# ------------------------------------------------------------------------------
# WARNING: NEVER expose this key to client-side code or prefix with NEXT_PUBLIC_.
# It completely bypasses Row Level Security (RLS) policies.
#
# KEY FORMAT NOTES:
# 1. Legacy JWT Format (Default & standard for @supabase/supabase-js v2):
#    eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# 2. New Supabase 2024+ Format:
#    sb_secret_your_secret_key_here
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY:
# Privileged service_role secret key for administrative server tasks.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# SUPABASE_SECRET_KEY:
# Alias supporting either legacy JWT format or modern 2024+ format
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# ------------------------------------------------------------------------------
# 6. TECHNICAL SEO, CRAWLABILITY & SEARCH ENGINE VERIFICATION
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION:
# Google Search Console HTML tag verification code (google-site-verification token)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token-here

# NEXT_PUBLIC_BING_SITE_VERIFICATION:
# Bing Webmaster Tools verification code (msvalidate.01 meta token)
NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-verification-token-here

# INDEXNOW_KEY:
# 32-character hex key for instant indexing submission to Bing, Yandex, and Naver
INDEXNOW_KEY=your-indexnow-key-here

# ------------------------------------------------------------------------------
# 7. MAPS, GEOCODING, ROUTING & PLACES CONFIGURATION
# ------------------------------------------------------------------------------
# KindLink uses a multi-tiered provider architecture with automatic failover,
# zero-cost community fallbacks (OSM, Photon, Nominatim, Overpass), rate limit
# protection, and privacy-preserving proxying.

# Provider API Keys:
# GEOAPIFY_API_KEY: Geocoding, reverse geocoding, routing, and places search.
# Obtain free tier key (3,000 requests/day) at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# ORS_API_KEY: OpenRouteService directions and distance matrix.
# Obtain free tier key (2,000 requests/day) at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_openrouteservice_api_key_here

# MAP TILES:
# Primary: OpenFreeMap vector tiles (ZERO API KEY REQUIRED, unlimited).
# Optional: MapTiler (only if you want commercial satellite & outdoor contour layers).
# Obtain free tier key at https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY=
NEXT_PUBLIC_MAPTILER_API_KEY=

# MAPS_CONTACT_EMAIL: Required by OpenStreetMap & Nominatim Usage Policy for User-Agent.
# Provide a valid admin or project contact email.
MAPS_CONTACT_EMAIL=maps-admin@kindlink.app

# Map Themes and Styles:
# Default MapTiler styles for light and dark modes (when MapTiler is active)
MAPTILER_STYLE_LIGHT=streets-v2
MAPTILER_STYLE_DARK=dataviz-dark

# Geographical Bounding Box (South, West, North, East):
# Constrains geocoding bias and view limits to Asansol / Paschim Bardhaman region
MAP_BOUNDS=23.50,86.70,23.85,87.20

# Active Provider Priority Chains (Comma-separated, evaluated in order):
# Tile fallback: OpenFreeMap (zero-key primary) -> MapTiler (optional) -> OpenStreetMap (standard raster)
MAP_TILE_PROVIDERS=openfreemap,maptiler,osm
# Geocode fallback: Geoapify -> Photon (OSM-based) -> Nominatim
GEOCODE_PROVIDERS=geoapify,photon,nominatim
# Route fallback: OpenRouteService -> Geoapify -> OSRM demo/public
ROUTE_PROVIDERS=ors,geoapify,osrm
# Places fallback: Geoapify Places -> Overpass API
PLACES_PROVIDERS=geoapify,overpass

# Soft Limits (Proactive rate-limit protection before quota exhaustion):
# Request caps. When reached, traffic gracefully cascades to free community providers.
MAPTILER_MONTHLY_LIMIT=100000
GEOAPIFY_DAILY_LIMIT=3000
ORS_DAILY_LIMIT=2000
MAPS_SOFT_LIMIT_ALERT_PERCENT=80

# Cache TTLs (in seconds):
MAPS_CACHE_GEOCODE_TTL=86400
MAPS_CACHE_ROUTE_TTL=3600
MAPS_CACHE_PLACES_TTL=43200
MAPS_CACHE_TILES_TTL=604800

# ------------------------------------------------------------------------------
# 8. IPINFO & GEO-IP AUTOMATIC LANGUAGE DETECTION (Server-Only, Private)
# ------------------------------------------------------------------------------
# KindLink uses IPinfo Lite API to detect country on the user's first visit
# to automatically choose a relevant starting language.
#
# CRITICAL SECURITY INVARIANT:
# NEVER expose IPINFO_TOKEN to client bundles (NEXT_PUBLIC_ prefix is STRICTLY PROHIBITED).
# IP lookups are performed exclusively server-side. IP addresses are NEVER logged,
# stored in databases, or tracked.
#
# IPINFO_TOKEN:
# Private token for IPinfo Lite API queries (50,000 requests/month free tier).
# Sign up at https://ipinfo.io/signup to obtain your free access token.
IPINFO_TOKEN=3bceff41ceb2e5

# IPINFO_TIMEOUT_MS:
# Hard timeout cap (in milliseconds) for server-side IP country lookups.
# Keeps first-visit page response time fast even under slow upstream networks.
# Default: 600ms
IPINFO_TIMEOUT_MS=600

# IPINFO_MODE:
# Operation mode: 'api' for live IPinfo Lite API queries, or 'disabled' to skip.
IPINFO_MODE=api

# ALLOW_TEST_COUNTRY:
# Set to 'true' to allow DEV_FORCE_COUNTRY and x-test-country header override for testing.
# Keep 'false' in production.
ALLOW_TEST_COUNTRY=false
