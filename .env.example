# ==============================================================================
# KindLink Environment Configuration (.env.example)
# Community Mutual Aid Platform - Asansol Engineering College
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Render deployment, see .env.render or render.yaml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Port the Node.js server listens on (default: 3000)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATA SOURCE CONFIGURATION
# ------------------------------------------------------------------------------
# DATA_SOURCE determines whether KindLink communicates with the live Supabase
# PostgreSQL backend or operates entirely in offline mock simulation mode.
#
# Options:
#   - 'supabase' (Default): Connects to live Supabase backend (PostgreSQL, Auth,
#                           Realtime channels, RLS policies, and RPCs).
#   - 'mock'              : Fully self-contained offline demonstration mode. Uses
#                           pre-seeded in-memory mock datasets (helpful for offline
#                           presentations, unit tests, and air-gapped demos).
DATA_SOURCE=supabase
NEXT_PUBLIC_DATA_SOURCE=supabase

# ------------------------------------------------------------------------------
# 3. SUPABASE PUBLIC CREDENTIALS (Client & Server)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL:
# The REST & WebSocket endpoint URL of your Supabase project.
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
# Scope: Exposed to the browser (prefixed with NEXT_PUBLIC_). Safe for client bundles.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY:
# The public/anon JWT API key for your Supabase project.
# Governed by Row Level Security (RLS) policies defined in PostgreSQL.
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon public)
# Scope: Exposed to the browser (prefixed with NEXT_PUBLIC_). Safe for client bundles.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
# An alias for NEXT_PUBLIC_SUPABASE_ANON_KEY (used in some modern Supabase templates).
# The KindLink client resolver (lib/supabase/client.ts) supports both keys interchangeably.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 4. SUPABASE SERVER SECRETS (Server-Only, Private)
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY:
# The privileged service_role secret key for administrative server tasks.
# WARNING: NEVER expose this key to client-side code or prefix with NEXT_PUBLIC_.
# It completely bypasses Row Level Security (RLS) policies.
# Used in: Server Actions, SSR Admin Clients, health checks, background jobs.
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys (service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# SUPABASE_SECRET_KEY:
# An alias for SUPABASE_SERVICE_ROLE_KEY.
# The KindLink admin client resolver (lib/supabase/admin.ts) supports both keys interchangeably.
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key-here
