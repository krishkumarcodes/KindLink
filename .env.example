# ==============================================================================
# KindLink Environment Configuration (.env.example)
# Community Mutual Aid Platform - Asansol Engineering College
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Render cloud deployment, see .env.render or render.yaml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Port the Node.js server listens on (default: 3000)
PORT=3000

# Environment mode ('development' or 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATA SOURCE CONFIGURATION
# ------------------------------------------------------------------------------
# DATA_SOURCE determines whether KindLink communicates with the live Supabase
# PostgreSQL backend or operates entirely in offline mock simulation mode.
#
# Options:
#   - 'supabase' (Default): Connects to live Supabase backend (PostgreSQL, Auth,
#                           Realtime channels, RLS policies, and RPCs).
#   - 'mock'              : Fully self-contained offline demonstration mode. Uses
#                           pre-seeded in-memory mock datasets (helpful for offline
#                           presentations, unit tests, and air-gapped demos).
DATA_SOURCE=supabase
NEXT_PUBLIC_DATA_SOURCE=supabase

# ------------------------------------------------------------------------------
# 3. BASE CANONICAL URL
# ------------------------------------------------------------------------------
# Used for canonical SEO links, metadata, Open Graph cards, sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. SUPABASE PUBLIC CREDENTIALS (Client & Server)
# ------------------------------------------------------------------------------
# Supabase Project: KindLink (pwfvaajngfmnmsfmqgyx)
# Region: ap-northeast-1 (Tokyo)
#
# KEY FORMAT NOTES:
# 1. Legacy JWT Format (Default & standard for @supabase/supabase-js v2 & Next.js):
#    eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB3ZnZhYWpuZ2Ztbm1zZm1xZ3l4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE4ODc3ODUsImV4cCI6MjEwNzQ2Mzc4NX0.LSbxXDJJe0PfZsf_JUPD88f5W9KAJVfyKMHIyTLDnWg
#
# 2. New Supabase 2024+ Format:
#    sb_publishable_JeO_LxYPZFhNoIl5a7tkZw_cogjbwdY
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL:
# The REST & WebSocket endpoint URL of your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://pwfvaajngfmnmsfmqgyx.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY:
# The public/anon JWT API key for your Supabase project. Safe for browser bundles.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB3ZnZhYWpuZ2Ztbm1zZm1xZ3l4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE4ODc3ODUsImV4cCI6MjEwNzQ2Mzc4NX0.LSbxXDJJe0PfZsf_JUPD88f5W9KAJVfyKMHIyTLDnWg

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:
# Alias supporting either legacy JWT format or modern 2024+ format (sb_publishable_JeO_LxYPZFhNoIl5a7tkZw_cogjbwdY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_JeO_LxYPZFhNoIl5a7tkZw_cogjbwdY

# ------------------------------------------------------------------------------
# 5. SUPABASE SERVER SECRETS (Server-Only, Private)
# ------------------------------------------------------------------------------
# WARNING: NEVER expose this key to client-side code or prefix with NEXT_PUBLIC_.
# It completely bypasses Row Level Security (RLS) policies.
#
# KEY FORMAT NOTES:
# 1. Legacy JWT Format (Default & standard for @supabase/supabase-js v2):
#    eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# 2. New Supabase 2024+ Format:
#    sb_secret_your_secret_key_here
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY:
# Privileged service_role secret key for administrative server tasks.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# SUPABASE_SECRET_KEY:
# Alias supporting either legacy JWT format or modern 2024+ format
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# ------------------------------------------------------------------------------
# 6. TECHNICAL SEO, CRAWLABILITY & SEARCH ENGINE VERIFICATION
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION:
# Google Search Console HTML tag verification code (google-site-verification token)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token-here

# NEXT_PUBLIC_BING_SITE_VERIFICATION:
# Bing Webmaster Tools verification code (msvalidate.01 meta token)
NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-verification-token-here

# INDEXNOW_KEY:
# 32-character hex key for instant indexing submission to Bing, Yandex, and Naver
INDEXNOW_KEY=your-indexnow-key-here
