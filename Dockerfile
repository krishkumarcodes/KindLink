ARG MAPS_CACHE_TILES_TTL="604800"

# Make build args available as environment variables during next build
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV DATA_SOURCE=$DATA_SOURCE
ENV NEXT_PUBLIC_DATA_SOURCE=$NEXT_PUBLIC_DATA_SOURCE
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=$NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION
ENV NEXT_PUBLIC_BING_SITE_VERIFICATION=$NEXT_PUBLIC_BING_SITE_VERIFICATION
ENV INDEXNOW_KEY=$INDEXNOW_KEY
ENV NEXT_PUBLIC_MAPTILER_API_KEY=$NEXT_PUBLIC_MAPTILER_API_KEY
ENV MAPTILER_API_KEY=$MAPTILER_API_KEY
ENV GEOAPIFY_API_KEY=$GEOAPIFY_API_KEY
ENV ORS_API_KEY=$ORS_API_KEY
ENV MAPS_CONTACT_EMAIL=$MAPS_CONTACT_EMAIL
ENV MAPTILER_STYLE_LIGHT=$MAPTILER_STYLE_LIGHT
ENV MAPTILER_STYLE_DARK=$MAPTILER_STYLE_DARK
ENV MAP_BOUNDS=$MAP_BOUNDS
ENV MAP_TILE_PROVIDERS=$MAP_TILE_PROVIDERS
ENV GEOCODE_PROVIDERS=$GEOCODE_PROVIDERS
ENV ROUTE_PROVIDERS=$ROUTE_PROVIDERS
ENV PLACES_PROVIDERS=$PLACES_PROVIDERS
ENV MAPTILER_MONTHLY_LIMIT=$MAPTILER_MONTHLY_LIMIT
ENV GEOAPIFY_DAILY_LIMIT=$GEOAPIFY_DAILY_LIMIT
ENV ORS_DAILY_LIMIT=$ORS_DAILY_LIMIT
ENV MAPS_SOFT_LIMIT_ALERT_PERCENT=$MAPS_SOFT_LIMIT_ALERT_PERCENT
ENV MAPS_CACHE_GEOCODE_TTL=$MAPS_CACHE_GEOCODE_TTL
ENV MAPS_CACHE_ROUTE_TTL=$MAPS_CACHE_ROUTE_TTL
ENV MAPS_CACHE_PLACES_TTL=$MAPS_CACHE_PLACES_TTL
ENV MAPS_CACHE_TILES_TTL=$MAPS_CACHE_TILES_TTL

RUN npm run build

