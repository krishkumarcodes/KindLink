ARG MAP_TILE_PROVIDERS="maptiler,osm"
ARG GEOCODE_PROVIDERS="geoapify,photon,nominatim"
ARG ROUTE_PROVIDERS="ors,geoapify,osrm"
ARG PLACES_PROVIDERS="geoapify,overpass"
